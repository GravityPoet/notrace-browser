[Unit]
Description=NoTrace OAuth refresh broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=notrace-broker
Group=notrace-broker
EnvironmentFile=/etc/notrace-broker.env
ExecStart=/opt/notrace-broker/bin/notrace-broker --bind 127.0.0.1:18455
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/notrace-broker/state /opt/cliproxyapi/auths
UMask=0077

[Install]
WantedBy=multi-user.target
